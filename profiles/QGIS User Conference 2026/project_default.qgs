                    <Option type="Map">
                      <Option name="name" type="QString" value=""/>
                      <Option name="properties" type="Map">
                        <Option name="alpha" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="CASE  WHEN @vector_tile_zoom >= 14 THEN (CASE WHEN &quot;class&quot; IS 'via_ferrata' THEN 80 ELSE 100 END)  WHEN @vector_tile_zoom >= 13 THEN (CASE WHEN &quot;subclass&quot; IN ('bollard','communications_tower','water_tower','surveying_pyramid','spring','water_well','waterfall','wind_turbine','aerialway_closed_pylon','aerialway_transportation_pylon','goods_pylon','cable_car_pylon','gondola_pylon','chair_lift_pylon') THEN 100 ELSE CASE WHEN &quot;class&quot; IS 'stone' THEN 100 ELSE 0 END END)  WHEN @vector_tile_zoom >= 12 THEN (CASE WHEN &quot;subclass&quot; IN ('bollard','water_tower','surveying_pyramid','waterfall','wind_turbine') THEN 100 ELSE CASE WHEN &quot;class&quot; IS 'stone' THEN 100 ELSE 0 END END) ELSE (0) END"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                        <Option name="angle" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="CASE WHEN (&quot;direction&quot; IS NOT NULL) THEN &quot;direction&quot; ELSE 0 END"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                        <Option name="name" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="CASE WHEN &quot;subclass&quot; IN ('bollard') THEN '' WHEN &quot;subclass&quot; IN ('stone_1') THEN '' WHEN &quot;subclass&quot; IN ('stone_2') THEN '' WHEN &quot;subclass&quot; IN ('stone_3') THEN '' WHEN &quot;subclass&quot; IN ('stone_4') THEN '' WHEN &quot;subclass&quot; IN ('stone_5') THEN '' WHEN &quot;subclass&quot; IN ('water_tower') THEN '' WHEN &quot;subclass&quot; IN ('antenna') THEN '' WHEN &quot;subclass&quot; IN ('wayside_shrine','cross') THEN '' WHEN &quot;subclass&quot; IN ('spring') THEN '' WHEN &quot;subclass&quot; IN ('surveying_pyramid') THEN '' WHEN &quot;subclass&quot; IN ('water_tank') THEN '' WHEN &quot;subclass&quot; IN ('chimney') THEN '' WHEN &quot;subclass&quot; IN ('communications_tower') THEN '' WHEN &quot;subclass&quot; IN ('transformer') THEN '' WHEN &quot;subclass&quot; IN ('waterfall') THEN '' WHEN &quot;subclass&quot; IN ('wind_turbine') THEN '' WHEN &quot;subclass&quot; IN ('aerialway_closed_pylon','aerialway_transportation_pylon','goods_pylon') THEN '' WHEN &quot;subclass&quot; IN ('cable_car_pylon','gondola_pylon','chair_lift_pylon') THEN '' WHEN &quot;subclass&quot; IN ('direction') THEN '' ELSE '' END"/>
                          <Option name="type" type="int" value="3"/>
