 0.264583 WHEN @vector_tile_zoom > 18 THEN ( ( CASE WHEN &quot;class&quot; = 'transit' THEN 1.5 ELSE CASE WHEN &quot;service&quot; IN ('yard', 'siding') THEN 1.5 ELSE 2 END END ) * 0.264583 ) END"/>
