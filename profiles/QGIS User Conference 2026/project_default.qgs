t;&quot; = '6') THEN 7.5 WHEN (&quot;&quot; = '5') THEN 6.8 WHEN (&quot;&quot; = '4') THEN 6.1 WHEN (&quot;&quot; = '3') THEN 5.4 WHEN (&quot;&quot; = '2') THEN 4.7 WHEN (&quot;&quot; = '1') THEN 4 ELSE CASE WHEN &quot;class&quot; IN ('river', 'canal') THEN 10 ELSE 4 END END ) * 0.264583 ) END"/>
