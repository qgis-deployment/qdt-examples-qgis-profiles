                          <Option name="expression" type="QString" value="CASE  WHEN @vector_tile_zoom >= 15 THEN (CASE WHEN &quot;class&quot; IN ('spot_elevation','terrain_spot_elevation','lake_elevation') THEN 80 WHEN &quot;class&quot; IN ('sinkhole','sinkhole_ice','sinkhole_water','sinkhole_rock','sinkhole_scree') THEN 60 ELSE 100 END)  WHEN @vector_tile_zoom >= 14 THEN (CASE WHEN &quot;class&quot; IN ('spot_elevation','terrain_spot_elevation','lake_elevation') THEN 80 ELSE 0 END) ELSE (CASE WHEN &quot;class&quot; IS 'lake_elevation' THEN 80 ELSE 0 END) END"/>
                          <Option name="type" type="int" value="3"/>
