                          <Option name="expression" type="QString" value="with_variable('marker_size',CASE WHEN &quot;subclass&quot; IN ('bollard') THEN -1 WHEN &quot;subclass&quot; IN ('stone_1') THEN -1 WHEN &quot;subclass&quot; IN ('stone_2') THEN -1 WHEN &quot;subclass&quot; IN ('stone_3') THEN -1 WHEN &quot;subclass&quot; IN ('stone_4') THEN -1 WHEN &quot;subclass&quot; IN ('stone_5') THEN -1 WHEN &quot;subclass&quot; IN ('water_tower') THEN -1 WHEN &quot;subclass&quot; IN ('antenna') THEN -1 WHEN &quot;subclass&quot; IN ('wayside_shrine','cross') THEN -1 WHEN &quot;subclass&quot; IN ('spring') THEN -1 WHEN &quot;subclass&quot; IN ('surveying_pyramid') THEN -1 WHEN &quot;subclass&quot; IN ('water_tank') THEN -1 WHEN &quot;subclass&quot; IN ('chimney') THEN -1 WHEN &quot;subclass&quot; IN ('communications_tower') THEN -1 WHEN &quot;subclass&quot; IN ('transformer') THEN -1 WHEN &quot;subclass&quot; IN ('waterfall') THEN -1 WHEN &quot;subclass&quot; IN ('wind_turbine') THEN -1 WHEN &quot;subclass&quot; IN ('aerialway_closed_pylon','aerialway_transportation_pylon','goods_pylon') THEN -1 WHEN &quot;subclass&quot; IN ('cable_car_pylon','gondola_pylon','chair_lift_pylon') THEN -1 WHEN &quot;subclass&quot; IN ('direction') THEN -1 ELSE -1 END,(scale_linear(@vector_tile_zoom,13,18,CASE WHEN &quot;subclass&quot; IN ('stone_1', 'stone_2', 'stone_3', 'stone_4', 'stone_5') THEN 0.35 WHEN &quot;subclass&quot; IN ('antenna', 'bollard', 'water_tower', 'water_tank', 'wayside_shrine', 'cross', 'spring', 'surveying_pyramid', 'gondola_pylon', 'chair_lift_pylon', 'aerialway_closed_pylon', 'aerialway_transportation_pylon', 'goods_pylon') THEN 0.55 WHEN &quot;subclass&quot; IN ('chimney', 'transformer', 'waterfall', 'cable_car_pylon') THEN 0.65 WHEN &quot;subclass&quot; IN ('communications_tower', 'wind_turbine') THEN 0.75 WHEN (&quot;subclass&quot; = 'direction') THEN CASE WHEN (&quot;class&quot; = 'via_ferrata') THEN 0.75 ELSE 1.05 END ELSE 0.35 END,CASE WHEN &quot;subclass&quot; IN ('antenna', 'stone_1', 'stone_2', 'stone_3', 'stone_4', 'stone_5', 'water_tower', 'wayside_shrine', 'cross', 'spring', 'surveying_pyramid', 'chimney', 'gondola_pylon', 'chair_lift_pylon', 'aerialway_closed_pylon', 'aerialway_transportation_pylon', 'goods_pylon') THEN 0.85 WHEN &quot;subclass&quot; IN ('communications_tower', 'water_tank', 'transformer', 'direction', 'waterfall', 'wind_turbine', 'cable_car_pylon') THEN 1.05 WHEN (&quot;subclass&quot; = 'bollard') THEN 1.3 ELSE 0.55 END))*@marker_size)"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                      </Option>
                      <Option name="type" type="QString" value="collection"/>
                    </Option>
