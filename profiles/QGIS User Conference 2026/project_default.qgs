;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 20 WHEN (&quot;class&quot; = 'trail') THEN 12 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 20 ELSE 8 END END ) * 0.264583 ) END) > 0"/>
                          <Option name="type" type="int" value="3"/>
