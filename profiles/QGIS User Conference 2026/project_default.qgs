r', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 1.15 ELSE CASE WHEN &quot;subclass&quot; IN ('funicular', 'subway') THEN 1.15 WHEN (&quot;subclass&quot; = 'tram') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0 END END END)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 14 THEN (scale_linear(@vector_tile_zoom,13,14,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 1.15 ELSE CASE WHEN &quot;subclass&quot; IN ('funicular', 'subway') THEN 1.15 WHEN (&quot;subclass&quot; = 'tram') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0 END END END,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 1.25 ELSE CASE WHEN &quot;subclass&quot; IN ('subway', 'funicular', 'narrow_gauge') THEN 1.25 WHEN (&quot;subclass&quot; = 'tram') THEN 0.75 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0.25 END END END)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,14,18,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 1.25 ELSE CASE WHEN &quot;subclass&quot; IN ('subway', 'funicular', 'narrow_gauge') THEN 1.25 WHEN (&quot;subclass&quot; = 'tram') THEN 0.75 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0.25 END END END,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 1.5 ELSE 2 END)) * 0.264583 WHEN @vector_tile_zoom > 18 THEN ( ( CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 1.5 ELSE 2 END ) * 0.264583 ) END"/>
