                          <Option name="expression" type="QString" value="array_to_string(array_foreach(CASE  WHEN @vector_tile_zoom >= 18 THEN (array(40,4))  WHEN @vector_tile_zoom >= 17 THEN (array(30,3))  WHEN @vector_tile_zoom >= 16 THEN (array(20,2))  WHEN @vector_tile_zoom >= 15 THEN (array(18,2)) ELSE (array(16,2)) END,@element * (CASE WHEN @vector_tile_zoom >= 11 AND @vector_tile_zoom &lt;= 12 THEN 0.198437 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_exponential(@vector_tile_zoom,12,13,0.75,1,2)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 15 THEN (scale_exponential(@vector_tile_zoom,13,15,1,1.25,2)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN (scale_exponential(@vector_tile_zoom,15,16,1.25,2,2)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 20 THEN (scale_exponential(@vector_tile_zoom,16,20,2,5,2)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN 1.32292 END)), ';')"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                        <Option name="enabled" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="(CASE WHEN @vector_tile_zoom >= 11 AND @vector_tile_zoom &lt;= 12 THEN 0.198437 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_exponential(@vector_tile_zoom,12,13,0.75,1,2)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 15 THEN (scale_exponential(@vector_tile_zoom,13,15,1,1.25,2)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN (scale_exponential(@vector_tile_zoom,15,16,1.25,2,2)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 20 THEN (scale_exponential(@vector_tile_zoom,16,20,2,5,2)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN 1.32292 END) > 0"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                        <Option name="outlineColor" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom &lt; 10 THEN set_color_part(@symbol_color, 'alpha', 0) WHEN @vector_tile_zoom >= 10 AND @vector_tile_zoom &lt; 11 THEN set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,10,11,(0) * 255,(CASE WHEN &quot;class&quot; = 'path' THEN CASE WHEN (&quot;is_route&quot; = 11) THEN 1 ELSE 0 END ELSE 0 END) * 255)) WHEN @vector_tile_zoom >= 11 AND @vector_tile_zoom &lt; 12 THEN set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,11,12,(CASE WHEN &quot;class&quot; = 'path' THEN CASE WHEN (&quot;is_route&quot; = 11) THEN 1 ELSE 0 END ELSE 0 END) * 255,(CASE WHEN &quot;class&quot; = 'path' THEN CASE WHEN (&quot;is_route&quot; = 11) THEN 1 ELSE CASE WHEN &quot;sac_scale&quot; IN ('hiking', 'mountain_hiking', 'alpine_hiking') THEN 1 ELSE 0 END END ELSE 0 END) * 255)) WHEN @vector_tile_zoom >= 12 AND @vector_tile_zoom &lt; 13 THEN set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,12,13,(CASE WHEN &quot;class&quot; = 'path' THEN CASE WHEN (&quot;is_route&quot; = 11) THEN 1 ELSE CASE WHEN &quot;sac_scale&quot; IN ('hiking', 'mountain_hiking', 'alpine_hiking') THEN 1 ELSE 0 END END ELSE 0 END) * 255,(CASE WHEN &quot;class&quot; = 'path' THEN 1 ELSE 0.5 END) * 255)) WHEN @vector_tile_zoom >= 13 THEN set_color_part(@symbol_color, 'alpha', (CASE WHEN &quot;class&quot; = 'path' THEN 1 ELSE 0.5 END) * 255) END"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                        <Option name="outlineWidth" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom >= 11 AND @vector_tile_zoom &lt;= 12 THEN 0.198437 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_exponential(@vector_tile_zoom,12,13,0.75,1,2)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 15 THEN (scale_exponential(@vector_tile_zoom,13,15,1,1.25,2)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN (scale_exponential(@vector_tile_zoom,15,16,1.25,2,2)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 20 THEN (scale_exponential(@vector_tile_zoom,16,20,2,5,2)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN 1.32292 END"/>
                          <Option name="type" type="int" value="3"/>
