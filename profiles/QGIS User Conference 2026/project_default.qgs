                    <Option type="Map">
                      <Option name="name" type="QString" value=""/>
                      <Option name="properties" type="Map">
                        <Option name="customDash" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="array_to_string(array_foreach(CASE  WHEN @vector_tile_zoom >= 16 THEN (array(6,3.75))  WHEN @vector_tile_zoom >= 15 THEN (array(5,3.125))  WHEN @vector_tile_zoom >= 14 THEN (array(4,2.5)) ELSE (array(3,1.875)) END,@element * (CASE WHEN @vector_tile_zoom >= 8 AND @vector_tile_zoom &lt;= 10 THEN (scale_linear(@vector_tile_zoom,8,10,0.5,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 0.75 WHEN &quot;subclass&quot; IN ('tram', 'subway') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 10 AND @vector_tile_zoom &lt;= 12 THEN (scale_linear(@vector_tile_zoom,10,12,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 0.75 WHEN &quot;subclass&quot; IN ('tram', 'subway') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1 ELSE 0 END END,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 1 WHEN &quot;subclass&quot; IN ('tram', 'subway') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_linear(@vector_tile_zoom,12,13,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 1 WHEN &quot;subclass&quot; IN ('tram', 'subway') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0 END END,CASE WHEN &quot;subclass&quot; IN ('funicular', 'subway') THEN 1.15 WHEN (&quot;subclass&quot; = 'tram') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 14 THEN (scale_linear(@vector_tile_zoom,13,14,CASE WHEN &quot;subclass&quot; IN ('funicular', 'subway') THEN 1.15 WHEN (&quot;subclass&quot; = 'tram') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0 END END,CASE WHEN &quot;subclass&quot; IN ('subway', 'funicular', 'narrow_gauge') THEN 1.25 WHEN (&quot;subclass&quot; = 'tram') THEN 0.75 ELSE 1.25 END)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,14,18,CASE WHEN &quot;subclass&quot; IN ('subway', 'funicular', 'narrow_gauge') THEN 1.25 WHEN (&quot;subclass&quot; = 'tram') THEN 0.75 ELSE 1.25 END,2)) * 0.264583 WHEN @vector_tile_zoom > 18 THEN 0.529167 END)), ';')"/>
