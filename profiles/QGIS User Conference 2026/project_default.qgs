                        <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom >= 9 AND @vector_tile_zoom &lt;= 10 THEN (scale_linear(@vector_tile_zoom,9,10,0,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1 ELSE 0 END)) * 100 WHEN @vector_tile_zoom > 10 AND @vector_tile_zoom &lt;= 11 THEN (scale_linear(@vector_tile_zoom,10,11,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1 ELSE 0 END,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1 WHEN (&quot;class&quot; = 'footway') THEN CASE WHEN (&quot;is_route&quot; = 11) THEN 1 ELSE 0 END ELSE 0 END)) * 100 WHEN @vector_tile_zoom > 11 AND @vector_tile_zoom &lt;= 12 THEN (scale_linear(@vector_tile_zoom,11,12,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1 WHEN (&quot;class&quot; = 'footway') THEN CASE WHEN (&quot;is_route&quot; = 11) THEN 1 ELSE 0 END ELSE 0 END,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1 WHEN (&quot;class&quot; = 'footway') THEN CASE WHEN (&quot;is_route&quot; = 11) THEN 1 ELSE CASE WHEN &quot;sac_scale&quot; IN ('hiking', 'mountain_hiking', 'alpine_hiking') THEN 1 ELSE 0 END END ELSE 0 END)) * 100 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_linear(@vector_tile_zoom,12,13,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1 WHEN (&quot;class&quot; = 'footway') THEN CASE WHEN (&quot;is_route&quot; = 11) THEN 1 ELSE CASE WHEN &quot;sac_scale&quot; IN ('hiking', 'mountain_hiking', 'alpine_hiking') THEN 1 ELSE 0 END END ELSE 0 END,CASE WHEN &quot;class&quot; IN ('car_ferry', 'ferry', 'footway') THEN 1 ELSE 0.5 END)) * 100 WHEN @vector_tile_zoom > 13 THEN ( ( CASE WHEN &quot;class&quot; IN ('car_ferry', 'ferry', 'footway') THEN 1 ELSE 0.5 END ) * 100 ) END"/>
