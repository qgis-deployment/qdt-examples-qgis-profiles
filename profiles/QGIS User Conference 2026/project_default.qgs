                          <Option name="expression" type="QString" value="CASE  WHEN @vector_tile_zoom >= 15 THEN (80) ELSE (CASE WHEN (to_real(&quot;lake_depth&quot;) % 100) IS 0 THEN 80 ELSE 0 END) END"/>
