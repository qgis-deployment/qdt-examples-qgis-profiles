                          <Option name="expression" type="QString" value="CASE WHEN &quot;class&quot; IN ('aerialway_closed','aerialway_transportation','aerialway_goods','goods_conveyor') THEN '#4b4b4b' WHEN &quot;class&quot; IS 'drag_lift' THEN '#c59c63' ELSE '#cb4d4d' END"/>
