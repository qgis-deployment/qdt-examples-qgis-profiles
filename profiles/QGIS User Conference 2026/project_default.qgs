                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom &lt; 8 THEN color_hsla(326, 53, 85, 255) WHEN @vector_tile_zoom >= 8 AND @vector_tile_zoom &lt; 14 THEN color_hsla(scale_linear(@vector_tile_zoom,8,14,326,331), scale_linear(@vector_tile_zoom,8,14,53,79), scale_linear(@vector_tile_zoom,8,14,85,60), 255) WHEN @vector_tile_zoom >= 14 THEN color_hsla(331, 79, 60, 255) ELSE color_hsla(331, 79, 60, 255) END"/>
