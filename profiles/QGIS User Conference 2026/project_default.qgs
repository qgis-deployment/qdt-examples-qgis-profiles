                          <Option name="expression" type="QString" value="(CASE WHEN @vector_tile_zoom >= 11 AND @vector_tile_zoom &lt;= 12 THEN (scale_linear(@vector_tile_zoom,11,12,CASE WHEN (&quot;&quot; = 0) THEN 0.75 ELSE 0 END,CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END)) * 0.264583 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 14 THEN (scale_linear(@vector_tile_zoom,12,14,CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END,CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 15 THEN (scale_linear(@vector_tile_zoom,14,15,CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END,CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1 ELSE 0 END)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,15,18,CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1 ELSE 0 END,CASE WHEN (&quot;&quot; = 0) THEN 3 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1.25 END)) * 0.264583 WHEN @vector_tile_zoom > 18 THEN ( ( CASE WHEN (&quot;&quot; = 0) THEN 3 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1.25 END ) * 0.264583 ) END) > 0"/>
