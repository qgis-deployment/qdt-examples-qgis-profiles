                          <Option name="expression" type="QString" value="CASE WHEN &quot;class&quot; IN ('sinkhole') THEN 'base64:' WHEN &quot;class&quot; IN ('sinkhole_ice','sinkhole_water','lake_spot_depth') THEN 'base64:' WHEN &quot;class&quot; IN ('sinkhole_rock','sinkhole_scree') THEN 'base64:' WHEN &quot;class&quot; IN ('spot_elevation','terrain_spot_elevation') THEN 'base64:' WHEN &quot;class&quot; IN ('lake_elevation') THEN '' ELSE '' END"/>
                          <Option name="type" type="int" value="3"/>
