                          <Option name="expression" type="QString" value="array_to_string(array_foreach(CASE  WHEN @vector_tile_zoom >= 18 THEN (array(18,4))  WHEN @vector_tile_zoom >= 17 THEN (array(13,3))  WHEN @vector_tile_zoom >= 16 THEN (array(8,2))  WHEN @vector_tile_zoom >= 15 THEN (array(7,2)) ELSE (array(6,2)) END,@element * (CASE WHEN @vector_tile_zoom >= 8 AND @vector_tile_zoom &lt;= 11 THEN (scale_exponential(@vector_tile_zoom,8,11,0.4,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1 ELSE 0.75 END,2)) * 0.264583 WHEN @vector_tile_zoom > 11 AND @vector_tile_zoom &lt;= 12 THEN (scale_exponential(@vector_tile_zoom,11,12,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1 ELSE 0.75 END,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1.2 ELSE 0.75 END,2)) * 0.264583 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_exponential(@vector_tile_zoom,12,13,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1.2 ELSE 0.75 END,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1.5 ELSE 1 END,2)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 15 THEN (scale_exponential(@vector_tile_zoom,13,15,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1.5 ELSE 1 END,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1.75 WHEN (&quot;class&quot; = 'ferry') THEN 1 ELSE 1.25 END,2)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN (scale_exponential(@vector_tile_zoom,15,16,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 1.75 WHEN (&quot;class&quot; = 'ferry') THEN 1 ELSE 1.25 END,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 2.5 WHEN (&quot;class&quot; = 'ferry') THEN 1.5 ELSE 2 END,2)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 20 THEN (scale_exponential(@vector_tile_zoom,16,20,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 2.5 WHEN (&quot;class&quot; = 'ferry') THEN 1.5 ELSE 2 END,CASE WHEN (&quot;class&quot; = 'car_ferry') THEN 8 WHEN (&quot;class&quot; = 'ferry') THEN 3 ELSE 5 END,2)) * 