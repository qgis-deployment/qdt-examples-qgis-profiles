                          <Option name="expression" type="QString" value="with_variable('marker_size',CASE WHEN &quot;class&quot; IN ('sinkhole') THEN 2 WHEN &quot;class&quot; IN ('sinkhole_ice','sinkhole_water','lake_spot_depth') THEN 2 WHEN &quot;class&quot; IN ('sinkhole_rock','sinkhole_scree') THEN 2 WHEN &quot;class&quot; IN ('spot_elevation','terrain_spot_elevation') THEN 1 WHEN &quot;class&quot; IN ('lake_elevation') THEN 1 ELSE 1 END,(CASE WHEN (&quot;class&quot; = 'lake_spot_depth') THEN 0.6 ELSE 1 END)*@marker_size)"/>
