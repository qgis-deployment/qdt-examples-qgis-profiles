HEN 1.5 ELSE 1.25 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 3 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1.25 END END ) * 0.264583 ) END) > 0"/>
