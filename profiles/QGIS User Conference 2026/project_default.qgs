                          <Option name="type" type="int" value="3"/>
                        </Option>
                        <Option name="fillColor" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="CASE WHEN &quot;class&quot; IN ('ferry','car_ferry') THEN '#4da4da' ELSE '#3c3c3c' END"/>
