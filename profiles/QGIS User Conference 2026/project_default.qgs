          <style enabled="1" expression="(&quot;class&quot; IN ('track', 'track_construction', 'via_ferrata', 'via_ferrata_construction')) AND ((&quot;subclass&quot; IS NULL OR &quot;subclass&quot; NOT IN ('steps', 'covered_bridge'))) AND (&quot;brunnel&quot; IS NULL) AND (_geom_type IS 'LineString')" geometry="1" layer="transportation" max-zoom="-1" min-zoom="10" name="road_track_via_ferrata">
