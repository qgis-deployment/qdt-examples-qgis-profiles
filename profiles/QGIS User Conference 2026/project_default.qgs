                          <Option name="expression" type="QString" value="CASE WHEN &quot;class&quot; IN ('sinkhole','sinkhole_rock','sinkhole_scree','sinkhole_water','sinkhole_ice') THEN 3.96875 ELSE 0 END"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                        <Option name="name" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="CASE WHEN &quot;class&quot; IN ('sinkhole') THEN '' WHEN &quot;class&quot; IN ('sinkhole_ice','sinkhole_water','lake_spot_depth') THEN '' WHEN &quot;class&quot; IN ('sinkhole_rock','sinkhole_scree') THEN '' WHEN &quot;class&quot; IN ('doline') THEN '' WHEN &quot;class&quot; IN ('spot_elevation','terrain_spot_elevation') THEN '' WHEN &quot;class&quot; IN ('lake_elevation') THEN '' ELSE '' END"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                        <Option name="width" type="Map">
                          <Option name="active" type="bool" value="true"/>
                          <Option name="expression" type="QString" value="with_variable('marker_size',CASE WHEN &quot;class&quot; IN ('sinkhole') THEN -1 WHEN &quot;class&quot; IN ('sinkhole_ice','sinkhole_water','lake_spot_depth') THEN -1 WHEN &quot;class&quot; IN ('sinkhole_rock','sinkhole_scree') THEN -1 WHEN &quot;class&quot; IN ('doline') THEN -1 WHEN &quot;class&quot; IN ('spot_elevation','terrain_spot_elevation') THEN -1 WHEN &quot;class&quot; IN ('lake_elevation') THEN -1 ELSE -1 END,(scale_linear(@vector_tile_zoom,13,16,CASE WHEN (&quot;class&quot; = 'doline') THEN 0.5 WHEN (&quot;class&quot; = 'lake_spot_depth') THEN 0.6 WHEN &quot;class&quot; IN ('terrain_spot_elevation', 'spot_elevation') THEN 0.7 WHEN (&quot;class&quot; = 'lake_elevation') THEN 1 ELSE 0.85 END,CASE WHEN &quot;class&quot; IN ('doline', 'lake_elevation', 'sinkhole', 'sinkhole_rock', 'sinkhole_scree', 'sinkhole_water', 'sinkhole_ice') THEN 1 ELSE 0.9 END))*@marker_size)"/>
                          <Option name="type" type="int" value="3"/>
                        </Option>
                      </Option>
                      <Option name="type" type="QString" value="collection"/>
                    </Option>
                  </data_defined_properties>
                </layer>
              </symbol>
            </symbols>
