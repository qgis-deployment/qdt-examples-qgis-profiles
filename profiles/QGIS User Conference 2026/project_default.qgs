          <style enabled="1" expression="(CASE WHEN &quot;subclass&quot; IN ('bollard', 'chimney', 'communications_tower', 'direction', 'shooting', 'water_tower', 'antenna_area', 'wayside_shrine', 'water_well', 'cross', 'spring', 'surveying_pyramid', 'water_tank', 'wind_turbine', 'transformer', 'aerialway_closed_pylon', 'aerialway_transportation_pylon', 'goods_pylon', 'cable_car_pylon', 'gondola_pylon', 'chair_lift_pylon') THEN TRUE WHEN (&quot;subclass&quot; = 'waterfall') THEN CASE WHEN (&quot;name&quot; IS NULL) THEN TRUE ELSE FALSE END ELSE FALSE END) OR (&quot;class&quot; = 'stone')" geometry="0" layer="poi" max-zoom="-1" min-zoom="12" name="poi_rank3_rotation_flat">
