                          <Option name="expression" type="QString" value="(CASE WHEN @vector_tile_zoom >= 8 AND @vector_tile_zoom &lt;= 10 THEN (scale_linear(@vector_tile_zoom,8,10,0.5,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 0.75 ELSE CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 0.75 WHEN &quot;subclass&quot; IN ('tram', 'subway') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1 ELSE 0 END END END)) * 0.264583 WHEN @vector_tile_zoom > 10 AND @vector_tile_zoom &lt;= 12 THEN (scale_linear(@vector_tile_zoom,10,12,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 0.75 ELSE CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 0.75 WHEN &quot;subclass&quot; IN ('tram', 'subway') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1 ELSE 0 END END END,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 1 ELSE CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 1 WHEN &quot;subclass&quot; IN ('tram', 'subway') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0 END END END)) * 0.264583 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_linear(@vector_tile_zoom,12,13,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_car', 'chair_lift', 'drag_lift', 'gondola', 'goods_conveyor') THEN 1 ELSE CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 1 WHEN &quot;subclass&quot; IN ('tram', 'subway') THEN 0 ELSE CASE WHEN (&quot;is_route&quot; IS NOT NULL) THEN 1.25 ELSE 0 END END END,CASE WHEN &quot;class&quot; IN ('aerialway_closed', 'aerialway_goods', 'aerialway_transportation', 'cable_c