                          <Option name="expression" type="QString" value="array_to_string(array_foreach(CASE  WHEN @vector_tile_zoom >= 13 THEN (array(0.3,0.95)) ELSE (array(0.25,0.85)) END,@element * (CASE WHEN @vector_tile_zoom >= 11 AND @vector_tile_zoom &lt;= 13 THEN (scale_exponential(@vector_tile_zoom,11,13,2,CASE WHEN &quot;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 2.5 WHEN (&quot;class&quot; = 'trail') THEN 2 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 2.5 ELSE 1.5 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 15 THEN (scale_exponential(@vector_tile_zoom,13,15,CASE WHEN &quot;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 2.5 WHEN (&quot;class&quot; = 'trail') THEN 2 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 2.5 ELSE 1.5 END END,CASE WHEN &quot;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 3.5 WHEN (&quot;class&quot; = 'trail') THEN 3 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 3.5 ELSE 1.75 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN (scale_exponential(@vector_tile_zoom,15,16,CASE WHEN &quot;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 3.5 WHEN (&quot;class&quot; = 'trail') THEN 3 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 3.5 ELSE 1.75 END END,CASE WHEN &quot;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 5 WHEN (&quot;class&quot; = 'trail') THEN 3.5 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 5 ELSE 2 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 20 THEN (scale_exponential(@vector_tile_zoom,16,20,CASE WHEN &quot;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 5 WHEN (&quot;class&quot; = 'trail') THEN 3.5 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 5 ELSE 2 END END,CASE WHEN &quot;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 20 WHEN (&quot;class&quot; = 'trail') THEN 12 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 20 ELSE 8 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN ( ( CASE WHEN &quot;class&quot; IN ('via_ferrata', 'via_ferrata_construction') THEN 20 WHEN (&quot;class&quot; = 'trail') THEN 12 ELSE CASE WHEN &quot;subclass&quot; = 'steps' THEN 20 ELSE 8 END END ) * 0.264583 ) END)), ';')"/>
