                          <Option name="expression" type="QString" value="with_variable('marker_size',CASE WHEN &quot;lake_depth&quot; IS NOT NULL THEN -1 ELSE -1 END,(CASE WHEN @vector_tile_zoom >= 13 AND @vector_tile_zoom &lt;= 14 THEN scale_linear(@vector_tile_zoom,13,14,0.6,0.7) WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 16 THEN scale_linear(@vector_tile_zoom,14,16,0.7,CASE WHEN (&quot;&quot; = 0) THEN 0.9 ELSE 0.7 END) WHEN @vector_tile_zoom > 16 THEN ( ( CASE WHEN (&quot;&quot; = 0) THEN 0.9 ELSE 0.7 END ) * 1 ) END)*@marker_size)"/>
