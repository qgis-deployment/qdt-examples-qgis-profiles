                          <Option name="expression" type="QString" value="array_to_string(array_foreach(CASE WHEN @vector_tile_zoom &lt;= 15 THEN array(3,1) WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN array(6,2) WHEN @vector_tile_zoom > 16 THEN array(9,3) END,@element * (CASE WHEN @vector_tile_zoom >= 2 AND @vector_tile_zoom &lt;= 7 THEN (scale_linear(@vector_tile_zoom,2,7,CASE WHEN (&quot;admin_level&quot; = 2) THEN 2 ELSE 0 END,CASE WHEN (&quot;admin_level&quot; = 2) THEN 4 ELSE 0 END)) * 0.264583 WHEN @vector_tile_zoom > 7 AND @vector_tile_zoom &lt;= 8 THEN (scale_linear(@vector_tile_zoom,7,8,CASE WHEN (&quot;admin_level&quot; = 2) THEN 4 ELSE 0 END,CASE WHEN (&quot;admin_level&quot; = 2) THEN 6 ELSE 2 END)) * 0.264583 WHEN @vector_tile_zoom > 8 AND @vector_tile_zoom &lt;= 11 THEN (scale_linear(@vector_tile_zoom,8,11,CASE WHEN (&quot;admin_level&quot; = 2) THEN 6 ELSE 2 END,CASE WHEN (&quot;admin_level&quot; = 2) THEN 10 WHEN (&quot;admin_level&quot; = 4) THEN 5 ELSE 0 END)) * 0.264583 WHEN @vector_tile_zoom > 11 AND @vector_tile_zoom &lt;= 12 THEN (scale_linear(@vector_tile_zoom,11,12,CASE WHEN (&quot;admin_level&quot; = 2) THEN 10 WHEN (&quot;admin_level&quot; = 4) THEN 5 ELSE 0 END,CASE WHEN (&quot;admin_level&quot; = 2) THEN 10 WHEN (&quot;admin_level&quot; = 4) THEN 5 ELSE 2 END)) * 0.264583 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,12,18,CASE WHEN (&quot;admin_level&quot; = 2) THEN 10 WHEN (&quot;admin_level&quot; = 4) THEN 5 ELSE 2 END,CASE WHEN (&quot;admin_level&quot; = 2) THEN 24 WHEN (&quot;admin_level&quot; = 4) THEN 16 ELSE 4 END)) * 0.264583 WHEN @vector_tile_zoom > 18 AND @vector_tile_zoom &lt;= 20 THEN (scale_linear(@vector_tile_zoom,18,20,CASE WHEN (&quot;admin_level&quot; = 2) THEN 24 WHEN (&quot;admin_level&quot; = 4) THEN 16 ELSE 4 END,CASE WHEN (&quot;admin_level&quot; = 2) THEN 40 WHEN (&quot;admin_level&quot; = 4) THEN 32 ELSE 6 END)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN ( ( CASE WHEN (&quot;admin_level&quot; = 2) THEN 40 WHEN (&quot;admin_level&quot; = 4) THEN 32 ELSE 6 END ) * 0.264583 ) END)), ';')"/>
