          <style enabled="1" expression="(CASE WHEN &quot;class&quot; IN ('trail', 'via_ferrata', 'via_ferrata_construction', 'footway_construction', 'minor_construction', 'motorway_construction', 'path_construction', 'primary_construction', 'secondary_construction', 'service_construction', 'tertiary_construction', 'track_construction', 'trunk_construction') THEN &quot;brunnel&quot; IS NOT 'tunnel' ELSE FALSE END) OR (CASE WHEN &quot;subclass&quot; = 'steps' THEN &quot;brunnel&quot; IS NOT 'tunnel' ELSE FALSE END)" geometry="1" layer="transportation" max-zoom="-1" min-zoom="10" name="road_small_dashes">
